# Copy this file to .env.local and fill in the values.
#
# Local development: run `npm run db:setup` to start Postgres via Docker
# (see docker-compose.yml) and seed test accounts, then use the value below
# as-is.
DATABASE_URL=postgresql://haven:haven_dev@localhost:5432/handcrafted_haven

# Generate your own with: openssl rand -hex 32
AUTH_SECRET=

# Production deployments should NOT use the values above — set DATABASE_URL
# to the hosted database's connection string and a unique AUTH_SECRET in the
# hosting platform's environment variables instead. src/lib/db.ts detects a
# non-localhost host automatically and enables SSL, so no code change is
# needed to switch.
