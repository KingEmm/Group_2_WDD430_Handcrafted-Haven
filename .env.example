# The app reads two variables: DATABASE_URL and AUTH_SECRET.
# Copy this file to .env.local and fill in the values.
#
# Local development: run `npm run db:setup` to start Postgres via Docker
# (see docker-compose.yml) and seed test accounts, then use the value below
# as-is.
DATABASE_URL=postgresql://haven:haven_dev@localhost:5432/handcrafted_haven

# Generate your own with: openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Keeping local and production databases separate (no swapping)
#
# Next.js loads .env.development.local BEFORE .env.local, but only during
# `next dev` — and never in production. So put the LOCAL database URL in a
# .env.development.local file:
#
#   # .env.development.local  (git-ignored)
#   DATABASE_URL=postgresql://haven:haven_dev@localhost:5432/handcrafted_haven
#
# Result: `npm run dev` uses your local DB automatically, while the deployed
# app uses the DATABASE_URL set in the hosting platform (Vercel) — the code
# just reads process.env.DATABASE_URL, no swapping and no code change.
# ---------------------------------------------------------------------------

# Production deployments should NOT use the values above — set DATABASE_URL
# to the hosted database's connection string and a unique AUTH_SECRET in the
# hosting platform's environment variables instead. src/lib/db.ts detects a
# non-localhost host automatically and enables SSL, so no code change is
# needed to switch.
#
# Note: when you point DATABASE_URL at a fresh database, apply the schema
# first (see sql/setup.sh / the SQL files in sql/) — otherwise queries fail
# with `relation "products" does not exist`.
